<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet failOnError="false" author="Emeka Ilozue" id="1652433182071-pharmacy-24">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="drug"/>
            </not>
        </preConditions>
        <createTable tableName="drug">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="drug_pkey"/>
            </column>
            <column name="name" type="VARCHAR(2147483647)"/>
            <column name="abbrev" type="VARCHAR(2147483647)"/>
            <column name="drug_group_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="archived" type="INT"/>
            <column name="code" type="VARCHAR(2147483647)"/>
        </createTable>
    </changeSet>



    <changeSet failOnError="false" author="Emeka Ilozue" id="1652433182071-pharmacy-26">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="drug_group"/>
            </not>
        </preConditions>
        <createTable tableName="drug_group">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="drug_group_pkey"/>
            </column>
            <column name="name" type="VARCHAR(2147483647)"/>
            <column name="code" type="VARCHAR(2147483647)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(2147483647)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="modified_by" type="VARCHAR(2147483647)"/>
            <column name="archived" type="INT"/>
        </createTable>
    </changeSet>

    <changeSet failOnError="false" author="Emeka Ilozue" id="1652433182071-pharmacy-27">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="drug_inventory"/>
            </not>
        </preConditions>
        <createTable tableName="drug_inventory">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="drug_inventory_pkey"/>
            </column>
            <column name="drug_id" type="BIGINT"/>
            <column name="brand_name" type="VARCHAR(2147483647)"/>
            <column name="strength" type="VARCHAR(2147483647)"/>
            <column name="pack_size" type="INT"/>
            <column name="dosage_form" type="VARCHAR(2147483647)"/>
            <column name="code" type="VARCHAR(2147483647)"/>
            <column name="date_created" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(2147483647)"/>
            <column name="date_modified" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="modified_by" type="VARCHAR(2147483647)"/>
            <column name="archived" type="INT"/>
        </createTable>
    </changeSet>





    <changeSet failOnError="false" author="Emeka Ilozue" id="1652433182071-pharmacy-32">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="drug_group_id_fk" />
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="drug_group_id" baseTableName="drug" constraintName="drug_group_id_fk" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="drug_group"/>
    </changeSet>



    <changeSet failOnError="false" author="Emeka Ilozue" id="1652433182071-pharmacy-34">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="drug_order_id_fk" />
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="drug_order_id" baseTableName="drug_dispense" constraintName="drug_order_id_fk" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="drug_order"/>
    </changeSet>


    <changeSet id="drop-and-recreate-drug-order-and-dispense-tables" author="Graceman">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="drug_order"/>
            <tableExists tableName="drug_dispense"/>
        </preConditions>

        <dropForeignKeyConstraint baseTableName="drug_dispense"
                                  constraintName="fk_drug_dispense_drug_order"/>
        <dropForeignKeyConstraint baseTableName="drug_dispense"
                                  constraintName="fk_drug_dispense_patient"/>
        <dropForeignKeyConstraint baseTableName="drug_order"
                                  constraintName="fk_drug_order_patient"/>
        <dropForeignKeyConstraint baseTableName="drug_order"
                                  constraintName="fk_drug_order_visit"/>

        <dropTable tableName="drug_order"/>
        <dropTable tableName="drug_dispense"/>

        <createTable tableName="drug_order">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="drug_order_pkey"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="visit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="medication_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="formulation" type="VARCHAR(255)"/>
            <column name="drug_brand_name" type="VARCHAR(255)"/>
            <column name="strength" type="VARCHAR(255)"/>
            <column name="dosage_amount" type="VARCHAR(255)"/>
            <column name="route_of_admin" type="VARCHAR(255)"/>
            <column name="frequency" type="VARCHAR(255)"/>
            <column name="timing_instructions" type="VARCHAR(255)"/>
            <column name="duration" type="VARCHAR(255)"/>
            <column name="duration_unit" type="VARCHAR(255)"/>
            <column name="quantity_prescribed" type="VARCHAR(255)"/>
            <column name="refills_allowed" type="INT" defaultValue="0"/>
            <column name="refills_remaining" type="INT" defaultValue="0"/>
            <column name="prescription_type" type="VARCHAR(255)"/>
            <column name="notes" type="TEXT"/>
            <column name="prescribed_by" type="BIGINT"/>
            <column name="prescriber_name" type="VARCHAR(255)"/>
            <column name="prescription_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="TIMESTAMP"/>
            <column name="end_date" type="TIMESTAMP"/>
            <column name="encounter_date" type="TIMESTAMP"/>
            <column name="order_status" type="VARCHAR(50)" defaultValue="ACTIVE"/>
            <column name="dispensing_status" type="VARCHAR(50)" defaultValue="PENDING"/>
            <column name="archived" type="INT" defaultValue="0"/>
            <column name="organisation_unit_id" type="BIGINT"/>

            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="date_modified" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>


        <createTable tableName="drug_dispense">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="drug_dispense_pkey"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="drug_order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="medication_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="brand_name" type="VARCHAR(255)"/>
            <column name="manufacturer" type="VARCHAR(255)"/>
            <column name="batch_number" type="VARCHAR(255)"/>
            <column name="expiry_date" type="DATE"/>
            <column name="quantity_dispensed" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_unit" type="VARCHAR(255)"/>
            <column name="formulation" type="VARCHAR(255)"/>
            <column name="strength" type="VARCHAR(255)"/>
            <column name="encounter_date" type="TIMESTAMP"/>
            <column name="date_time_dispensed" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="dispensed_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dispenser_name" type="VARCHAR(255)"/>
            <column name="substitution_made" type="BOOLEAN" defaultValue="false"/>
            <column name="substitution_reason" type="VARCHAR(255)"/>
            <column name="dispensing_notes" type="TEXT"/>
            <column name="is_refill" type="BOOLEAN" defaultValue="false"/>
            <column name="refill_number" type="INT"/>
            <column name="archived" type="INT" defaultValue="0"/>
            <column name="organisation_unit_id" type="BIGINT"/>

            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="date_modified" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>


        <addForeignKeyConstraint baseTableName="drug_order"
                                 baseColumnNames="patient_id"
                                 constraintName="fk_drug_order_patient"
                                 referencedTableName="patient"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="drug_order"
                                 baseColumnNames="visit_id"
                                 constraintName="fk_drug_order_visit"
                                 referencedTableName="visit"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="drug_dispense"
                                 baseColumnNames="drug_order_id"
                                 constraintName="fk_drug_dispense_drug_order"
                                 referencedTableName="drug_order"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="drug_dispense"
                                 baseColumnNames="patient_id"
                                 constraintName="fk_drug_dispense_patient"
                                 referencedTableName="patient"
                                 referencedColumnNames="id"/>

        <createIndex tableName="drug_order" indexName="idx_drug_order_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="drug_order" indexName="idx_drug_order_visit_id">
            <column name="visit_id"/>
        </createIndex>
        <createIndex tableName="drug_order" indexName="idx_drug_order_medication_name">
            <column name="medication_name"/>
        </createIndex>
        <createIndex tableName="drug_order" indexName="idx_drug_order_archived">
            <column name="archived"/>
        </createIndex>


        <createIndex tableName="drug_dispense" indexName="idx_drug_dispense_drug_order_id">
            <column name="drug_order_id"/>
        </createIndex>
        <createIndex tableName="drug_dispense" indexName="idx_drug_dispense_patient_id">
            <column name="patient_id"/>
        </createIndex>
        <createIndex tableName="drug_dispense" indexName="idx_drug_dispense_medication_name">
            <column name="medication_name"/>
        </createIndex>
        <createIndex tableName="drug_dispense" indexName="idx_drug_dispense_archived">
            <column name="archived"/>
        </createIndex>
        <createIndex tableName="drug_dispense" indexName="idx_drug_dispense_date_time_dispensed">
            <column name="date_time_dispensed"/>
        </createIndex>


        <sql>SELECT pg_catalog.setval('public.drug_order_id_seq', 1, true);</sql>

        <sql>SELECT pg_catalog.setval('public.drug_dispense_id_seq', 1, true);</sql>
    </changeSet>


</databaseChangeLog>